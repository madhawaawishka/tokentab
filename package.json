{
  "name": "tokentab",
  "version": "0.3.0",
  "description": "Local-first LLM usage & cost tracker. Wrap your OpenAI/Anthropic/Gemini client in one line to measure tokens, cost, latency and per-feature spend — with a budget guard and a local dashboard. Zero exfiltration, zero runtime deps in the core.",
  "type": "module",
  "license": "MIT",
  "author": "madhawaawishka",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/index.browser.js",
    "./dist/index.browser.cjs",
    "./dist/auto.js",
    "./dist/auto.cjs",
    "./dist/auto.browser.js",
    "./dist/auto.browser.cjs",
    "./dist/register.js",
    "./dist/register.cjs"
  ],
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "tokens",
    "cost",
    "budget",
    "observability",
    "usage",
    "tracking",
    "local-first",
    "dashboard",
    "tokenmeter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhawaawishka/tokenmeter.git"
  },
  "homepage": "https://tokentab.netlify.app/",
  "bugs": {
    "url": "https://github.com/madhawaawishka/tokenmeter/issues"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs",
        "default": "./dist/index.browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./auto": {
      "browser": {
        "types": "./dist/auto.browser.d.ts",
        "import": "./dist/auto.browser.js",
        "require": "./dist/auto.browser.cjs",
        "default": "./dist/auto.browser.js"
      },
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      }
    },
    "./register": {
      "import": "./dist/register.js",
      "require": "./dist/register.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.browser.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tokentab": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --import ./scripts/ts-resolve.mjs --test --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "test:ci": "node --import ./scripts/ts-resolve.mjs --test --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@google/genai": "^2.8.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
